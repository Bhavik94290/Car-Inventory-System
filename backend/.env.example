# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored — it will never be committed.

DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# 64+ char random Base64 string
JWT_SECRET=change-me-to-a-64+char-random-base64-secret-change-me-please-000

# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Gmail SMTP for password-reset OTP emails. MAIL_USERNAME is the full Gmail
# address; MAIL_PASSWORD is a 16-character Google App Password (not your
# normal password) from https://myaccount.google.com/apppasswords — requires
# 2-Step Verification enabled on the account. MAIL_FROM defaults to
# MAIL_USERNAME if left unset.
MAIL_USERNAME=your.name@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=your.name@gmail.com

UPLOAD_DIR=uploads/vehicles
